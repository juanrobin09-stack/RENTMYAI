# =============================================================================
# RentMyAI — Variables d'environnement
# Copier en `.env` (local) ou les ajouter dans Vercel → Settings → Env Variables.
# NE JAMAIS committer `.env`.
# =============================================================================

# #############################################################################
# OBLIGATOIRE — sans ces 8 variables, le site ne fonctionne pas
# #############################################################################

# --- 1 & 2. Base de données (Supabase) ---
# Supabase → bouton "Connect" → onglet ORMs → Prisma. Copier les 2 lignes.
# Remplacer [PASSWORD] par le mot de passe de la base.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- 3 & 4. Authentification (Better Auth) ---
# Générer le secret avec : openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL publique du site (sans / final). En local : http://localhost:3000
BETTER_AUTH_URL="https://ton-site.vercel.app"

# --- 5. URL de l'app (même valeur que BETTER_AUTH_URL) ---
NEXT_PUBLIC_APP_URL="https://ton-site.vercel.app"

# --- 6. Claude (Anthropic) — chat IA ---
# console.anthropic.com → API keys (penser à ajouter du crédit)
ANTHROPIC_API_KEY="sk-ant-..."

# --- 7. Voyage AI — embeddings RAG ---
# dash.voyageai.com → API Keys
VOYAGE_API_KEY="pa-..."

# --- 8. UploadThing — upload des PDF ---
# uploadthing.com → Dashboard → API Keys (un seul token suffit)
UPLOADTHING_TOKEN="..."

# #############################################################################
# PAIEMENTS (Stripe) — requis seulement pour vendre/encaisser
# #############################################################################

# dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
# dashboard.stripe.com → Developers → Webhooks → endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# #############################################################################
# OPTIONNEL — valeurs par défaut sensées si non renseignées
# #############################################################################

# Modèles IA (défauts ci-dessous)
ANTHROPIC_CHAT_MODEL="claude-sonnet-4-6"
VOYAGE_EMBEDDING_MODEL="voyage-3.5"

# Commissions (en %)
PLATFORM_FEE_PERCENT="20"           # part gardée par la plateforme
AFFILIATE_COMMISSION_PERCENT="15"   # part reversée aux affiliés
AFFILIATE_COOKIE_DAYS="30"          # durée du cookie d'affiliation

# Connexion sociale (laisser vide pour désactiver)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
