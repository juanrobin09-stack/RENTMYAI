# ----------------------------------------------------------------------------
# RentMyAI — Variables d'environnement
# Copier en `.env` et remplir les valeurs. NE JAMAIS committer `.env`.
# ----------------------------------------------------------------------------

# --- Database (PostgreSQL + pgvector) ---
# Recommandé: Neon, Supabase ou Vercel Postgres (pgvector activé)
DATABASE_URL="postgresql://user:password@host:5432/rentmyai?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/rentmyai?sslmode=require"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Better Auth ---
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers (optionnel)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- OpenAI ---
OPENAI_API_KEY="sk-..."
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Stripe Connect ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."
# Commission plateforme en pourcentage (ex: 20 = 20%)
PLATFORM_FEE_PERCENT="20"

# --- UploadThing ---
UPLOADTHING_TOKEN="..."
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="..."

# --- Affiliation ---
AFFILIATE_COMMISSION_PERCENT="15"
AFFILIATE_COOKIE_DAYS="30"
